<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{B8A11724-5D17-45E1-A4E3-6B6CD309D0E6}</ProjectGuid>
    <Keyword>MakeFileProj</Keyword>
    <RootNamespace>SoundCraft</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ReplaceWildcardsInProjectItems>true</ReplaceWildcardsInProjectItems>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <CargoTarget>x86_64-pc-windows-msvc</CargoTarget>
    <CargoToolchain Condition="'$(CargoToolchain)' == ''">1.95.0-x86_64-pc-windows-msvc</CargoToolchain>
    <CargoOutputProfile Condition="'$(Configuration)' == 'Debug'">debug</CargoOutputProfile>
    <CargoOutputProfile Condition="'$(Configuration)' == 'Release'">release</CargoOutputProfile>
    <CargoFeatureArguments Condition="'$(CargoFeatures)' != ''">-Features "$(CargoFeatures)"</CargoFeatureArguments>
    <CargoOfflineArgument Condition="'$(CargoOffline)' == 'true'">-Offline</CargoOfflineArgument>
    <OutDir>$(RepoRoot)target\visual-studio\$(CargoTarget)\$(CargoOutputProfile)\</OutDir>
    <IntDir>$(RepoRoot)target\visual-studio\msbuild\$(Configuration)\</IntDir>
    <!-- Cargo, rather than the IDE timestamp check, owns dependency freshness. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <NMakeBuildCommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy RemoteSigned -File "$(RepoRoot)packaging\windows\visual-studio.ps1" -Action Build -Configuration "$(Configuration)" -Toolchain "$(CargoToolchain)" $(CargoFeatureArguments) $(CargoOfflineArgument)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy RemoteSigned -File "$(RepoRoot)packaging\windows\visual-studio.ps1" -Action Rebuild -Configuration "$(Configuration)" -Toolchain "$(CargoToolchain)" $(CargoFeatureArguments) $(CargoOfflineArgument)</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy RemoteSigned -File "$(RepoRoot)packaging\windows\visual-studio.ps1" -Action Clean -Configuration "$(Configuration)" -Toolchain "$(CargoToolchain)"</NMakeCleanCommandLine>
    <NMakeOutput>$(OutDir)soundcraft.exe</NMakeOutput>
    <LocalDebuggerCommand>$(NMakeOutput)</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(RepoRoot)</LocalDebuggerWorkingDirectory>
    <LocalDebuggerDebuggerType>NativeOnly</LocalDebuggerDebuggerType>
    <LocalDebuggerEnvironment>RUST_BACKTRACE=1</LocalDebuggerEnvironment>
    <LocalDebuggerMergeEnvironment>true</LocalDebuggerMergeEnvironment>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <RustupHome Condition="'$(RUSTUP_HOME)' != ''">$(RUSTUP_HOME)</RustupHome>
    <RustupHome Condition="'$(RustupHome)' == ''">$(USERPROFILE)\.rustup</RustupHome>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Cargo.toml;Cargo.lock;README.md;AGENTS.md;LICENSE-MIT;LICENSE-APACHE;NOTICE" />
    <None Include=".cargo\config.toml" Condition="Exists('.cargo\config.toml')" />
    <None Include="apps\**\*.rs;apps\**\Cargo.toml;crates\**\*.rs;crates\**\Cargo.toml;xtask\**\*.rs;xtask\Cargo.toml" />
    <None Include="packaging\windows\visual-studio.ps1;docs\visual-studio.md" />
    <Natvis Include="$(RustupHome)\toolchains\$(CargoToolchain)\lib\rustlib\etc\*.natvis" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
